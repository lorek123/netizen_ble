{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Add Pet Netizen feeder",
        "description": "Choose a feeder found by Home Assistant's Bluetooth.",
        "data": {
          "address": "Device",
          "verification_code": "Verification code"
        },
        "data_description": {
          "verification_code": "Leave 00000000 unless you set a custom code in the Pet Netizen app."
        }
      },
      "bluetooth_confirm": {
        "title": "Add Pet Netizen feeder",
        "description": "Add {name}?",
        "data": {
          "verification_code": "Verification code"
        },
        "data_description": {
          "verification_code": "Leave 00000000 unless you set a custom code in the Pet Netizen app."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_verification_code": "The feeder rejected the verification code. Use the code set in the Pet Netizen app, or 00000000 if you never set one."
    },
    "abort": {
      "already_configured": "Device is already configured",
      "no_devices_found": "No devices found on the network",
      "not_supported": "This device is not a supported Pet Netizen feeder."
    }
  },
  "entity": {
    "switch": {
      "child_lock": { "name": "Child lock" },
      "prompt_sound": { "name": "Prompt sound" },
      "led": { "name": "LED indicator" },
      "atmosphere_light": { "name": "Atmosphere light" },
      "auto_lock": { "name": "Auto lock" },
      "do_not_disturb": { "name": "Do not disturb" },
      "long_ring": { "name": "Long ring" },
      "cp01b_sound": { "name": "Sound" }
    },
    "sensor": {
      "battery_level": { "name": "Battery" },
      "power_source": {
        "name": "Power source",
        "state": { "mains": "Mains", "battery": "Battery" }
      },
      "feed_plan": { "name": "Feed plan" },
      "next_feeding": { "name": "Next feeding" },
      "feeding_status": {
        "name": "Feeding status",
        "state": { "idle": "Idle", "feeding": "Feeding", "done": "Done", "failed": "Failed" }
      },
      "last_feed_time": { "name": "Last feed time" },
      "tc02_auto_countdown_remaining": { "name": "Countdown remaining" }
    },
    "binary_sensor": {
      "fault": { "name": "Fault" },
      "low_battery": { "name": "Low battery" },
      "stuck_grain": { "name": "Food stuck" },
      "food_blocked": { "name": "Food outlet blocked" },
      "out_of_food": { "name": "Out of food" }
    },
    "button": {
      "feed_now": { "name": "Feed now" },
      "sync_time": { "name": "Sync time" }
    },
    "number": {
      "portions": { "name": "Portions" },
      "operation_mode": { "name": "Operation mode" },
      "rotation_mode": { "name": "Rotation mode" },
      "volume": { "name": "Volume" },
      "playback_frequency": { "name": "Playback frequency" },
      "sound_effect": { "name": "Sound effect" },
      "auto_mode_countdown": { "name": "Auto mode countdown" },
      "fun_mode": { "name": "Fun mode" },
      "tc02_operation_mode": { "name": "Operation mode" },
      "tc02_rotation_mode": { "name": "Rotation mode" },
      "tc02_mood_light_mode": { "name": "Mood light mode" },
      "tc02_led_color": { "name": "LED color" },
      "tc02_sound_effect": { "name": "Sound effect" },
      "tc02_playback_frequency": { "name": "Playback frequency" },
      "tc02_volume": { "name": "Volume" },
      "tc02_auto_mode_countdown": { "name": "Auto mode countdown" },
      "tc02_color_r": { "name": "Color red" },
      "tc02_color_g": { "name": "Color green" },
      "tc02_color_b": { "name": "Color blue" }
    },
    "time": {
      "dnd_start": { "name": "Do not disturb start" },
      "dnd_end": { "name": "Do not disturb end" }
    }
  },
  "services": {
    "set_feeding": {
      "name": "Set feeding",
      "description": "Adds a scheduled feeding, or updates the one at the same time.",
      "fields": {
        "device_id": { "name": "Feeder", "description": "The feeder to update." },
        "time": { "name": "Time", "description": "When to feed." },
        "weekdays": { "name": "Days", "description": "Days of the week to feed on." },
        "portions": { "name": "Portions", "description": "Portions to dispense (1–15)." },
        "enabled": { "name": "Enabled", "description": "Whether this feeding is active." }
      }
    },
    "remove_feeding": {
      "name": "Remove feeding",
      "description": "Removes the scheduled feeding at the given time.",
      "fields": {
        "device_id": { "name": "Feeder", "description": "The feeder to update." },
        "time": { "name": "Time", "description": "Time of the feeding to remove." }
      }
    },
    "set_feeding_schedule": {
      "name": "Set feeding schedule",
      "description": "Replaces the whole feeding schedule (up to 10 feedings).",
      "fields": {
        "device_id": { "name": "Feeder", "description": "The feeder to update." },
        "schedule": {
          "name": "Schedule",
          "description": "List of feedings, each with time (HH:MM), weekdays (mon–sun), portions (1–15) and enabled."
        }
      }
    },
    "set_feed_plan": {
      "name": "Set feed plan (deprecated)",
      "description": "Deprecated: use Set feeding schedule.",
      "fields": {
        "device_id": { "name": "Feeder", "description": "The feeder to update." },
        "schedule": { "name": "Schedule", "description": "Same as Set feeding schedule." }
      }
    }
  },
  "selector": {
    "weekday": {
      "options": {
        "mon": "Monday",
        "tue": "Tuesday",
        "wed": "Wednesday",
        "thu": "Thursday",
        "fri": "Friday",
        "sat": "Saturday",
        "sun": "Sunday"
      }
    }
  },
  "exceptions": {
    "device_not_found": { "message": "No Pet Netizen feeder found for device {device_id}." },
    "entry_not_loaded": { "message": "{name} is not loaded; check that the feeder is reachable." },
    "set_feed_plan_failed": { "message": "Could not write the feeding schedule to {name}." },
    "schedule_unknown": { "message": "The feeding schedule of {name} has not been read yet; try again when the feeder is reachable." },
    "too_many_feedings": { "message": "A feeder can hold at most {max} scheduled feedings." },
    "duplicate_feeding_time": { "message": "More than one feeding at {time}." },
    "feeding_not_found": { "message": "{name} has no feeding at {time}." }
  }
}
